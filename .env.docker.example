# Ready-to-copy environment for running the whole stack in Docker on your machine:
#   cp .env.docker.example .env && docker compose up --build
# Differs from .env.example only in the last three settings (CI keeps copying .env.example).

# Node.js Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=my_database
DB_USER=postgres
DB_PASSWORD=postgres

# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_database

# Security
JWT_SECRET=your_jwt_secret_change_in_production
SECRET_WORD=your_secret_word_change_in_production

# CORS Configuration: the browser opens the frontend on the host
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration: the bundle runs in the browser, so it calls the API through the host port
VITE_API_URL=http://localhost:3000

# Docker Compose: profile started by a plain `docker compose up` (db + API/Swagger + frontend)
COMPOSE_PROFILES=dev
